{
  "manifest_version": 3,
  "name": "mot mot",
  "version": "2.2",
  "description": "Highlight to Tweet — send any selection on the web straight to X.",
  "icons": {
    "16": "motmot16.png",
    "48": "motmot48.png",
    "128": "motmot128.png"
  },
  "action": {
    "default_title": "mot mot — highlight to Tweet",
    "default_icon": {
      "16": "motmot16.png",
      "48": "motmot48.png",
      "128": "motmot128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "jump.js"
      ],
      "css": [
        "jump.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.x.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "rewind.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "notifications",
    "alarms"
  ],
  "commands": {
    "tweet-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Tweet the current selection"
    }
  }
}
